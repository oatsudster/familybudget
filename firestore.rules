rules_version = '2';

// Link-based access, intentionally without login or membership checks.
// Anyone with a household ID can read, add, edit and delete its records.
// Household discovery/listing is denied; the random ID in the link is the capability.
service cloud.firestore {
  match /databases/{database}/documents {
    function validLink(id) {
      return id.matches('^[a-zA-Z0-9_-]{20,128}$');
    }
    function validTransaction() {
      let d = request.resource.data;
      return d.keys().hasAll(['type', 'category', 'amount', 'date', 'updatedAt'])
        && d.keys().hasOnly(['type', 'category', 'amount', 'quantity', 'date', 'time', 'note', 'createdAt', 'updatedAt'])
        && d.type in ['income', 'expense']
        && d.category is string && d.category.size() > 0 && d.category.size() <= 100
        && d.amount is number && d.amount > 0 && d.amount <= 1000000000000
        && d.get('quantity', 1) is int && d.get('quantity', 1) >= 1 && d.get('quantity', 1) <= 1000000
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (d.get('time', null) == null || (d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && d.get('note', '') is string && d.get('note', '').size() <= 2000
        && d.updatedAt == request.time;
    }
    function validCatalogItem() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'price', 'updatedAt'])
        && d.keys().hasOnly(['name', 'price', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 300
        && d.price is number && d.price > 0 && d.price <= 1000000000000
        && d.updatedAt == request.time;
    }
    match /households/{householdId} {
      allow read, write: if false;

      match /transactions/{txId} {
        allow read, delete: if validLink(householdId);
        allow create, update: if validLink(householdId) && validTransaction();
      }

      match /amwayItems/{itemId} {
        allow read, delete: if validLink(householdId);
        allow create, update: if validLink(householdId) && validCatalogItem();
      }
    }
  }
}
